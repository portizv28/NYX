# IA
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2:3b

# Voz: Porcupine es el modo de producción para la wake word.
# Obtén una clave y crea un modelo personalizado para "Nix" en Picovoice.
PICOVOICE_ACCESS_KEY=
NYX_PORCUPINE_KEYWORD_PATH=
NYX_PORCUPINE_MODEL_PATH=
NYX_WAKE_SENSITIVITY=0.45
NYX_WAKE_COOLDOWN_SECONDS=2.0
NYX_STT_ENGINE=faster_whisper
NYX_WHISPER_MODEL=base

# TTS: pyttsx3 funciona sin modelo adicional. Piper es opcional para voz local natural.
NYX_TTS_ENGINE=pyttsx3
NYX_TTS_RATE=155
NYX_TTS_VOLUME=0.9
NYX_PIPER_EXECUTABLE=piper
NYX_PIPER_MODEL_PATH=

# Actualidad: rutas y fuentes editables sin cambiar el código.
NYX_NEWS_SOURCES_PATH=config/news_sources.json
